{
    "version": 8,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "debug build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-multi",
            "configurePreset": "debug",
            "description": "Build with threads",
            "jobs": 0
        }
    ]
}